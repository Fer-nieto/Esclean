<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Esclean.ViewModels.Trays"
    x:DataType="vm:TrayInventoryViewModel"
    x:Class="Esclean.Views.Trays.TrayInventoryView">

    <Grid RowDefinitions="Auto,Auto,*"
          Margin="18">

        <!-- HEADER -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,18">

            <TextBlock
                Text="INVENTARIO DE CHAROLAS"
                FontSize="22"
                FontWeight="Bold"
                Foreground="{DynamicResource EscleanTextPrimary}"/>

            <TextBlock
                Text="Existencia actual por ubicación y tipo de charola"
                FontSize="12"
                Foreground="{DynamicResource EscleanTextMuted}"
                Margin="0,4,0,0"/>

        </StackPanel>


        <!-- FILTROS -->
        <Border
            Grid.Row="1"
            Background="#111B24"
            BorderBrush="{DynamicResource EscleanBorderSoft}"
            BorderThickness="1"
            CornerRadius="5"
            Padding="12"
            Margin="0,0,0,14">

            <Grid ColumnDefinitions="2*,2*,2*,Auto">

                <!-- ID CHAROLA -->
                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,10,0">

                    <TextBlock
                        Text="ID CHAROLA"
                        FontSize="11"
                        Foreground="{DynamicResource EscleanTextMuted}"
                        Margin="0,0,0,5"/>

                    <TextBox
                        Height="36"
                        PlaceholderText="Buscar charola..."
                        Text="{Binding FilterTrayId}"/>

                </StackPanel>


                <!-- MODELO CUT -->
                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,10,0">

                    <TextBlock
                        Text="MODELO CUT"
                        FontSize="11"
                        Foreground="{DynamicResource EscleanTextMuted}"
                        Margin="0,0,0,5"/>

                    <TextBox
                        Height="36"
                        PlaceholderText="Buscar modelo Cut..."
                        Text="{Binding FilterModel}"/>

                </StackPanel>


                <!-- UBICACIÓN -->
                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,10,0">

                    <TextBlock
                        Text="UBICACIÓN"
                        FontSize="11"
                        Foreground="{DynamicResource EscleanTextMuted}"
                        Margin="0,0,0,5"/>

                    <ComboBox
                        Height="36"
                        ItemsSource="{Binding Locations}"
                        SelectedItem="{Binding SelectedLocation}"
                        PlaceholderText="Todas"/>

                </StackPanel>


                <!-- BOTÓN -->
                <Button
                    Grid.Column="3"
                    Content="BUSCAR"
                    Height="36"
                    VerticalAlignment="Bottom"
                    Padding="20,0"
                    Command="{Binding SearchCommand}"/>

            </Grid>

        </Border>

        <!-- TABLA -->
        <Border
            Grid.Row="2"
            Background="#0D151C"
            BorderBrush="{DynamicResource EscleanBorderSoft}"
            BorderThickness="1"
            CornerRadius="5">

            <Grid RowDefinitions="Auto,*">

                <!-- ENCABEZADO -->
                <Border
                    Grid.Row="0"
                    Background="#111B24"
                    Padding="12,10">

                    <Grid ColumnDefinitions="1.4*,2*,1.5*,1*,1*,1*,1*,1*">

                        <TextBlock
                            Grid.Column="0"
                            Text="ID CHAROLA"
                            FontWeight="Bold"
                            FontSize="11"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="MODELO"
                            FontWeight="Bold"
                            FontSize="11"/>

                        <TextBlock
                            Grid.Column="2"
                            Text="PROVEEDOR"
                            FontWeight="Bold"
                            FontSize="11"/>

                        <TextBlock
                            Grid.Column="3"
                            Text="ESPACIOS"
                            FontWeight="Bold"
                            FontSize="11"/>

                        <TextBlock
                            Grid.Column="4"
                            Text="CLEANING"
                            FontWeight="Bold"
                            FontSize="11"/>

                        <TextBlock
                            Grid.Column="5"
                            Text="CUARTERIAS"
                            FontWeight="Bold"
                            FontSize="11"/>

                        <TextBlock
                            Grid.Column="6"
                            Text="PISO"
                            FontWeight="Bold"
                            FontSize="11"/>

                        <TextBlock
                            Grid.Column="7"
                            Text="SCRAP"
                            FontWeight="Bold"
                            FontSize="11"/>

                    </Grid>

                </Border>


                <!-- DATOS TEMPORALES -->
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">

                    <ItemsControl>

                        <Border
                            Padding="12,10"
                            BorderBrush="{DynamicResource EscleanBorderSoft}"
                            BorderThickness="0,0,0,1">

                            <Grid ColumnDefinitions="1.4*,2*,1.5*,1*,1*,1*,1*,1*">

                                <TextBlock
                                    Grid.Column="0"
                                    Text="TR-0001"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="A230"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="Proveedor 01"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="24"/>

                                <TextBlock
                                    Grid.Column="4"
                                    Text="10"/>

                                <TextBlock
                                    Grid.Column="5"
                                    Text="6"/>

                                <TextBlock
                                    Grid.Column="6"
                                    Text="8"/>

                                <TextBlock
                                    Grid.Column="7"
                                    Text="0"/>

                            </Grid>

                        </Border>

                    </ItemsControl>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</UserControl>