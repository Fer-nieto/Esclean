<UserControl
    xmlns:vm="using:Esclean.ViewModels.Trays"
    x:DataType="vm:TrayViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Esclean.Views.Trays.TrayView">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- HEADER -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,18">

            <TextBlock
                Text="CONTROL DE CHAROLAS"
                FontSize="30"
                FontWeight="Bold"
                Foreground="{DynamicResource EscleanTextPrimary}"/>

            <TextBlock
                Text="Gestión de inventario y movimientos de charolas"
                FontSize="22"
                Foreground="{DynamicResource EscleanTextMuted}"
                Margin="0,4,0,0"/>

        </StackPanel>


        <!-- NAVEGACIÓN -->
        <Border
            Grid.Row="1"
            Background="#111B24"
            BorderBrush="{DynamicResource EscleanBorderSoft}"
            BorderThickness="1"
            CornerRadius="5"
            Padding="5"
            Margin="0,0,0,14">

            <Grid ColumnDefinitions="*,*,*">
                <Button
                    Grid.Column="0"
                    Content="MOVIMIENTOS"
                    Command="{Binding ShowMovementsCommand}"
                    FontWeight="Bold"
                    Height="42"
                    Margin="2"/>
                
                <Button
                    Grid.Column="1"
                    Content="INVENTARIO"
                    Command="{Binding ShowInventoryCommand}"
                    FontWeight="Bold"
                    Height="42"
                    Margin="2"/>

                <Button
                    Grid.Column="2"
                    Content="CATÁLOGO"
                    Command="{Binding ShowCatalogCommand}"
                    FontWeight="Bold"
                    Height="42"
                    Margin="2"/>
            </Grid>
        </Border>


        <!-- CONTENIDO -->
        <Border
            Grid.Row="2"
            Background="#0D151C"
            BorderBrush="{DynamicResource EscleanBorderSoft}"
            BorderThickness="1"
            CornerRadius="5">

            <ContentControl Content="{Binding CurrentTrayView}"/>
        </Border>

    </Grid>

</UserControl>