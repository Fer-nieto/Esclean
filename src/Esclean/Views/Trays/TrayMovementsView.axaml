<UserControl
    xmlns:vm="using:Esclean.ViewModels.Trays"
    x:DataType="vm:TrayMovementsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Esclean.Views.Trays.TrayMovementsView">

    <Grid RowDefinitions="Auto,Auto,*"
          Margin="18">

        <!-- HEADER -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,18">

            <TextBlock
                Text="MOVIMIENTOS DE CHAROLAS"
                FontSize="25"
                FontWeight="Bold"
                Foreground="{DynamicResource EscleanTextPrimary}"/>

            <TextBlock
                Text="Registro histórico de entradas, salidas y cambios de ubicación"
                FontSize="16"
                Foreground="{DynamicResource EscleanTextMuted}"
                Margin="0,4,0,0"/>

        </StackPanel>
        
        <!-- Campos a llenar -->
<Border
    Grid.Row="1"
    Margin="0,0,0,14"
    Padding="16"
    Background="#111B24"
    BorderBrush="{DynamicResource EscleanBorderSoft}"
    BorderThickness="1"
    CornerRadius="6">

    <Grid
        ColumnDefinitions="2.2*,1*,1.5*,1.5*,Auto"
        ColumnSpacing="14">
        
        <!-- ID CHAROLA -->
        <StackPanel Grid.Column="0">

            <TextBlock
                Text="ID CHAROLA"
                FontSize="11"
                FontWeight="Bold"
                Foreground="{DynamicResource EscleanTextPrimary}"
                Margin="0,0,0,6"/>

            <ComboBox
                Height="38"
                ItemsSource="{Binding Trays}"
                SelectedItem="{Binding SelectedTray}"
                DisplayMemberBinding="{Binding IdTray}"
                PlaceholderText="Seleccione charola"/>

        </StackPanel>
        
        <!-- CANTIDAD -->
        <StackPanel Grid.Column="1">

            <TextBlock
                Text="CANTIDAD"
                FontSize="11"
                FontWeight="Bold"
                Foreground="{DynamicResource EscleanTextPrimary}"
                Margin="0,0,0,6"/>

            <NumericUpDown
                Height="38"
                Minimum="1"
                Maximum="999"
                Increment="1"
                Value="{Binding CurrentMovement.Quantity}"
                FormatString="0"/>

        </StackPanel>
        
        <!-- ORIGEN -->
        <StackPanel Grid.Column="2">

            <TextBlock
                Text="ORIGEN"
                FontSize="11"
                FontWeight="Bold"
                Foreground="{DynamicResource EscleanTextPrimary}"
                Margin="0,0,0,6"/>

            <ComboBox
                Height="38"
                PlaceholderText="Seleccione origen"
                SelectedItem="{Binding CurrentMovement.Origin}">

                <ComboBoxItem Content="CLEANING"/>
                <ComboBoxItem Content="PISO"/>
                <ComboBoxItem Content="CUARTERIA"/>

            </ComboBox>

        </StackPanel>
        
        <!-- DESTINO -->
        <StackPanel Grid.Column="3">

            <TextBlock
                Text="DESTINO"
                FontSize="11"
                FontWeight="Bold"
                Foreground="{DynamicResource EscleanTextPrimary}"
                Margin="0,0,0,6"/>

            <ComboBox
                Height="38"
                PlaceholderText="Seleccione destino"
                SelectedItem="{Binding CurrentMovement.Destination}">

                <ComboBoxItem Content="CLEANING"/>
                <ComboBoxItem Content="PISO"/>
                <ComboBoxItem Content="CUARTERIA"/>
                <ComboBoxItem Content="SCRAP"/>

            </ComboBox>

        </StackPanel>
        
        <!-- CONFIRMAR -->
        <Button
            Grid.Column="4"
            Content="CONFIRMAR"
            Height="38"
            MinWidth="125"
            Padding="20,10"
            VerticalAlignment="Bottom"
            FontWeight="Bold"
            Command="{Binding }"/>

    </Grid>

</Border>


        <!-- TABLA -->
        <Border
            Grid.Row="2"
            Background="#0D151C"
            BorderBrush="{DynamicResource EscleanBorderSoft}"
            BorderThickness="1"
            CornerRadius="5">

            <Grid RowDefinitions="Auto,*">

                <Border
                    Grid.Row="0"
                    Background="#111B24"
                    Padding="12,10">

                    <Grid ColumnDefinitions="1.2*,1*,1.5*,1.5*,1.5*,2*">

                        <TextBlock
                            Grid.Column="0"
                            Text="FECHA"
                            FontWeight="Bold"
                            FontSize="11"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="ID CHAROLA"
                            FontWeight="Bold"
                            FontSize="11"/>

                        <TextBlock
                            Grid.Column="2"
                            Text="CANTIDAD"
                            FontWeight="Bold"
                            FontSize="11"/>

                        <TextBlock
                            Grid.Column="3"
                            Text="ORIGEN"
                            FontWeight="Bold"
                            FontSize="11"/>

                        <TextBlock
                            Grid.Column="4"
                            Text="DESTINO"
                            FontWeight="Bold"
                            FontSize="11"/>

                        <TextBlock
                            Grid.Column="5"
                            Text="USUARIO"
                            FontWeight="Bold"
                            FontSize="11"/>

                    </Grid>

                </Border>


                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">

                    <ItemsControl>

                        <Border
                            Padding="12,10"
                            BorderBrush="{DynamicResource EscleanBorderSoft}"
                            BorderThickness="0,0,0,1">

                            <Grid ColumnDefinitions="1.2*,1*,1.5*,1.5*,1.5*,2*">

                                <TextBlock
                                    Grid.Column="0"
                                    Text="23/09/2026 08:30"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="TR-0001"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="ENTRADA"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="PISO"/>

                                <TextBlock
                                    Grid.Column="4"
                                    Text="CLEANING"/>

                                <TextBlock
                                    Grid.Column="5"
                                    Text="EMP-001"/>

                            </Grid>

                        </Border>

                    </ItemsControl>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</UserControl>