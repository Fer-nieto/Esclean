<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Esclean.ViewModels.Trays"
    x:Class="Esclean.Views.Trays.TraysView"
    x:DataType="vm:TraysViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ================================================= -->
        <!-- ENCABEZADO -->
        <!-- ================================================= -->

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,18">

            <TextBlock
                Text="CONTROL DE CHAROLAS"
                FontSize="26"
                FontWeight="Bold"
                Foreground="{DynamicResource EscleanTextPrimary}"/>

            <TextBlock
                Text="Gestión de inventario y movimientos de charolas"
                FontSize="12"
                Foreground="{DynamicResource EscleanTextMuted}"
                Margin="0,4,0,0"/>

        </StackPanel>


        <!-- ================================================= -->
        <!-- SUBMENU -->
        <!-- ================================================= -->

        <Border
            Grid.Row="1"
            Background="#111B24"
            BorderBrush="{DynamicResource EscleanBorderSoft}"
            BorderThickness="1"
            CornerRadius="5"
            Padding="5"
            Margin="0,0,0,14">

            <Grid ColumnDefinitions="*,*,*">

                <Button
                    Grid.Column="0"
                    Content="INVENTARIO"
                    Command="{Binding ShowInventoryCommand}"
                    Height="42"
                    Margin="2"/>

                <Button
                    Grid.Column="1"
                    Content="MOVIMIENTOS"
                    Command="{Binding ShowMovementsCommand}"
                    Height="42"
                    Margin="2"/>

                <Button
                    Grid.Column="2"
                    Content="CATÁLOGO"
                    Command="{Binding ShowCatalogCommand}"
                    Height="42"
                    Margin="2"/>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- CONTENIDO -->
        <!-- ================================================= -->

        <Border
            Grid.Row="2"
            Background="#0D151C"
            BorderBrush="{DynamicResource EscleanBorderSoft}"
            BorderThickness="1"
            CornerRadius="5">

            <ContentControl
                Content="{Binding CurrentTrayView}"/>

        </Border>

    </Grid>

</UserControl>