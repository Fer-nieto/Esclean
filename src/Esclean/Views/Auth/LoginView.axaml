<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Esclean.ViewModels.Auth"

    x:Class="Esclean.Views.Auth.LoginWindow"
    x:DataType="vm:LoginViewModel"

    Title="Esclean - Login"
    Width="500"
    Height="640"
    CanResize="False"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource EscleanBackground}">


    <Grid RowDefinitions="Auto,*,Auto">


        <!-- ====================================================== -->
        <!-- HEADER                                                -->
        <!-- ====================================================== -->

        <Border
            Grid.Row="0"

            Height="82"

            Background="{DynamicResource EscleanHeader}"

            BorderBrush="{DynamicResource EscleanBorder}"
            BorderThickness="0,0,0,1">


            <Grid Margin="24,0">


                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">


                    <!-- LOGO -->

                    <Border
                        Width="44"
                        Height="44"

                        CornerRadius="5"

                        Background="{DynamicResource EscleanIceBlueDark}"

                        BorderBrush="#4E8EAD"
                        BorderThickness="1">


                        <TextBlock
                            Text="E"

                            FontSize="25"
                            FontWeight="Bold"

                            Foreground="#74D2FF"

                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>


                    <!-- IDENTIDAD -->

                    <StackPanel
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">


                        <TextBlock
                            Text="ESCLEAN"

                            FontSize="24"
                            FontWeight="Bold"

                            Foreground="{DynamicResource EscleanTextPrimary}"/>


                        <TextBlock
                            Text="CLEANING ROOM CONTROL"

                            FontSize="10"

                            Foreground="{DynamicResource EscleanTextMuted}"

                            Margin="0,2,0,0"/>

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ====================================================== -->
        <!-- CONTENIDO LOGIN                                       -->
        <!-- ====================================================== -->

        <Grid
            Grid.Row="1"
            Margin="48">


            <Border
                VerticalAlignment="Center"

                Padding="32"

                CornerRadius="8"

                Background="{DynamicResource EscleanSidebar}"

                BorderBrush="{DynamicResource EscleanBorderSoft}"
                BorderThickness="1">


                <StackPanel Spacing="18">


                    <!-- TITULO -->

                    <StackPanel Spacing="5">


                        <TextBlock
                            Text="INICIAR SESIÓN"

                            FontSize="22"
                            FontWeight="Bold"

                            Foreground="{DynamicResource EscleanTextPrimary}"

                            HorizontalAlignment="Center"/>


                        <TextBlock
                            Text="Acceso al sistema de control de herramental"

                            FontSize="11"

                            Foreground="{DynamicResource EscleanTextMuted}"

                            HorizontalAlignment="Center"/>


                        <Border
                            Width="45"
                            Height="2"

                            Margin="0,10,0,5"

                            HorizontalAlignment="Center"

                            Background="{DynamicResource EscleanIceBlue}"/>

                    </StackPanel>


                    <!-- EMPLEADO -->

                    <StackPanel Spacing="7">


                        <TextBlock
                            Text="NÚMERO DE EMPLEADO"

                            FontSize="10"
                            FontWeight="Bold"

                            Foreground="{DynamicResource EscleanTextMuted}"/>


                        <TextBox
                            Text="{Binding EmployeeNumber}"

                            PlaceholderText="Ej. 136725"

                            Height="44"

                            FontSize="14"/>

                    </StackPanel>


                    <!-- PASSWORD -->

                    <StackPanel Spacing="7">


                        <TextBlock
                            Text="CONTRASEÑA"

                            FontSize="10"
                            FontWeight="Bold"

                            Foreground="{DynamicResource EscleanTextMuted}"/>


                        <TextBox
                            Text="{Binding Password}"

                            PasswordChar="●"

                            PlaceholderText="Ingresa tu contraseña"

                            Height="44"

                            FontSize="14"/>

                    </StackPanel>


                    <!-- MENSAJE -->

                    <Border
                        IsVisible="{Binding HasError}"

                        Background="#261416"

                        BorderBrush="#653238"
                        BorderThickness="1"

                        CornerRadius="4"

                        Padding="10">


                        <TextBlock
                            Text="{Binding ErrorMessage}"

                            Foreground="#FF8080"

                            FontSize="11"

                            TextWrapping="Wrap"/>

                    </Border>


                    <!-- BOTON LOGIN -->

                    <Button
                        Content="INICIAR SESIÓN"

                        Command="{Binding LoginCommand}"

                        Height="46"

                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"

                        Background="{DynamicResource EscleanIceBlueDark}"

                        Foreground="{DynamicResource EscleanTextPrimary}"

                        BorderBrush="#4E8EAD"
                        BorderThickness="1"

                        CornerRadius="4"

                        FontWeight="Bold"/>


                    <!-- TEST -->

                    <TextBlock
                        Text="Ambiente de desarrollo"

                        FontSize="11"

                        Foreground="#506273"

                        HorizontalAlignment="Center"

                        Margin="0,4,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ====================================================== -->
        <!-- FOOTER                                                -->
        <!-- ====================================================== -->

        <Border
            Grid.Row="2"

            Height="32"

            Background="#0B1219"

            BorderBrush="{DynamicResource EscleanBorderSoft}"
            BorderThickness="0,1,0,0">


            <Grid
                Margin="16,0"

                ColumnDefinitions="*,Auto">


                <StackPanel
                    Grid.Column="0"

                    Orientation="Horizontal"

                    VerticalAlignment="Center">


                    <Ellipse
                        Width="7"
                        Height="7"

                        Fill="{DynamicResource EscleanNormal}"

                        Margin="0,0,7,0"/>


                    <TextBlock
                        Text="Sistema disponible"

                        FontSize="9"

                        Foreground="{DynamicResource EscleanTextMuted}"/>

                </StackPanel>


                <TextBlock
                    Grid.Column="1"

                    Text="ESCLEAN 1.0"

                    FontSize="9"

                    Foreground="{DynamicResource EscleanTextMuted}"

                    VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</Window>