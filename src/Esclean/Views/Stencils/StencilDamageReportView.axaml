<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:vm="using:Esclean.ViewModels.Stencils"
    xmlns:models="using:Esclean.Models.Stencils"

    x:Class="Esclean.Views.Stencils.StencilDamageReportView"

    x:DataType="vm:StencilDamageReportViewModel">

    <!-- =========================================================
         REPORTES DE DAÑO - ESCLEAN
         Vista industrial para captura y consulta de daños
         ========================================================= -->

    <Grid Background="#0A1018">

        <Grid
            Margin="22"
            RowDefinitions="Auto,16,Auto,16,*">

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Border
                Grid.Row="0"
                Background="#0F1824"
                BorderBrush="#263545"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18,14">

                <Grid ColumnDefinitions="*,Auto">

                    <StackPanel
                        Grid.Column="0"
                        Spacing="4">

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="10">

                            <Border
                                Width="5"
                                Height="28"
                                Background="#E05252"
                                CornerRadius="2"/>

                            <TextBlock
                                Text="REPORTES DE DAÑO"
                                Foreground="#F4F7FA"
                                FontSize="24"
                                FontWeight="Bold"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                        <TextBlock
                            Text="Registro y seguimiento de daños detectados en stencils"
                            Foreground="#8999AA"
                            FontSize="13"
                            Margin="15,2,0,0"/>

                    </StackPanel>


                    <Button
                        Grid.Column="1"
                        Content="↻  ACTUALIZAR"
                        Command="{Binding LoadDamageReportsCommand}"
                        Width="145"
                        Height="38"
                        VerticalAlignment="Center"
                        Background="#182636"
                        Foreground="#DCE6EF"
                        BorderBrush="#35495D"
                        BorderThickness="1"
                        CornerRadius="5"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- CAPTURA + INFORMACIÓN -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="2"
                ColumnDefinitions="1.35*,18,1*">

                <!-- ============================================= -->
                <!-- CAPTURA -->
                <!-- ============================================= -->

                <Border
                    Grid.Column="0"
                    Background="#0F1824"
                    BorderBrush="#263545"
                    BorderThickness="1"
                    CornerRadius="8">

                    <Grid RowDefinitions="Auto,*">

                        <!-- CABECERA DEL PANEL -->

                        <Border
                            Grid.Row="0"
                            Background="#131F2C"
                            BorderBrush="#263545"
                            BorderThickness="0,0,0,1"
                            Padding="16,11"
                            CornerRadius="8,8,0,0">

                            <Grid ColumnDefinitions="*,Auto">

                                <StackPanel
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="9">

                                    <Border
                                        Width="8"
                                        Height="8"
                                        Background="#E05252"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Text="REGISTRAR REPORTE"
                                        Foreground="#DCE6EF"
                                        FontSize="14"
                                        FontWeight="SemiBold"/>

                                </StackPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="CAPTURA"
                                    Foreground="#60768B"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"/>

                            </Grid>

                        </Border>


                        <!-- FORMULARIO -->

                        <Grid
                            Grid.Row="1"
                            Margin="18"
                            RowDefinitions="Auto,14,Auto,14,Auto,14,Auto,14,Auto,18,Auto">


                            <!-- STEEL NO -->

                            <Grid
                                Grid.Row="0"
                                ColumnDefinitions="*,12,125">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="6">

                                    <TextBlock
                                        Text="STEEL NO."
                                        Foreground="#8194A7"
                                        FontSize="11"
                                        FontWeight="Bold"/>

                                    <TextBox
                                        Text="{Binding SteelNo}"
                                        PlaceholderText="Ingrese código del stencil"
                                        Height="38"
                                        Background="#0A121B"
                                        Foreground="#EEF3F7"
                                        BorderBrush="#2A3A49"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,0"/>

                                </StackPanel>


                                <Button
                                    Grid.Column="2"
                                    Content="BUSCAR"
                                    Command="{Binding SearchStencilCommand}"
                                    Height="38"
                                    VerticalAlignment="Bottom"
                                    Background="#1A4D6B"
                                    Foreground="White"
                                    BorderBrush="#2F759B"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    FontWeight="SemiBold"/>

                            </Grid>


                            <!-- EMPLEADO + LINEA -->

                            <Grid
                                Grid.Row="2"
                                ColumnDefinitions="1.4*,14,1*">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="6">

                                    <TextBlock
                                        Text="NÚMERO DE EMPLEADO"
                                        Foreground="#8194A7"
                                        FontSize="11"
                                        FontWeight="Bold"/>

                                    <TextBox
                                        Text="{Binding Reporter}"
                                        PlaceholderText="Ej. 1001"
                                        Height="38"
                                        Background="#0A121B"
                                        Foreground="#EEF3F7"
                                        BorderBrush="#2A3A49"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,0"/>

                                </StackPanel>


                                <StackPanel
                                    Grid.Column="2"
                                    Spacing="6">

                                    <TextBlock
                                        Text="LÍNEA"
                                        Foreground="#8194A7"
                                        FontSize="11"
                                        FontWeight="Bold"/>

                                    <ComboBox
                                        ItemsSource="{Binding Lines}"
                                        SelectedItem="{Binding SelectedLine}"
                                        Height="38"
                                        HorizontalAlignment="Stretch"
                                        Background="#0A121B"
                                        Foreground="#EEF3F7"
                                        BorderBrush="#2A3A49"
                                        BorderThickness="1"/>

                                </StackPanel>

                            </Grid>


                            <!-- TIPO DE DAÑO -->

                            <StackPanel
                                Grid.Row="4"
                                Spacing="6">

                                <TextBlock
                                    Text="TIPO DE DAÑO"
                                    Foreground="#8194A7"
                                    FontSize="11"
                                    FontWeight="Bold"/>

                                <ComboBox
                                    ItemsSource="{Binding DamageTypes}"
                                    SelectedItem="{Binding SelectedDamageType}"
                                    Height="38"
                                    HorizontalAlignment="Stretch"
                                    Background="#0A121B"
                                    Foreground="#EEF3F7"
                                    BorderBrush="#2A3A49"
                                    BorderThickness="1"/>

                            </StackPanel>


                            <!-- DESCRIPCIÓN -->

                            <StackPanel
                                Grid.Row="6"
                                Spacing="6">

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="DESCRIPCIÓN / OBSERVACIONES"
                                        Foreground="#8194A7"
                                        FontSize="11"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="OBLIGATORIO"
                                        Foreground="#C96A6A"
                                        FontSize="10"
                                        FontWeight="SemiBold"/>

                                </Grid>

                                <TextBox
                                    Text="{Binding Description}"
                                    PlaceholderText="Describa el daño, ubicación y condición encontrada..."
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinHeight="90"
                                    MaxHeight="120"
                                    Background="#0A121B"
                                    Foreground="#EEF3F7"
                                    BorderBrush="#2A3A49"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10"/>

                            </StackPanel>


                            <!-- SEPARADOR -->

                            <Border
                                Grid.Row="8"
                                Height="1"
                                Background="#243341"
                                VerticalAlignment="Center"/>


                            <!-- BOTÓN REGISTRO -->

                            <Button
                                Grid.Row="10"
                                Content="REGISTRAR REPORTE DE DAÑO"
                                Command="{Binding ConfirmCommand}"
                                Height="44"
                                HorizontalAlignment="Stretch"
                                Background="#922E32"
                                Foreground="#FFFFFF"
                                BorderBrush="#C24B50"
                                BorderThickness="1"
                                CornerRadius="5"
                                FontSize="13"
                                FontWeight="Bold"/>

                        </Grid>

                    </Grid>

                </Border>


                <!-- ============================================= -->
                <!-- INFORMACIÓN STENCIL -->
                <!-- ============================================= -->

                <Border
                    Grid.Column="2"
                    Background="#0F1824"
                    BorderBrush="#263545"
                    BorderThickness="1"
                    CornerRadius="8">

                    <Grid RowDefinitions="Auto,*">

                        <!-- HEADER INFO -->

                        <Border
                            Grid.Row="0"
                            Background="#131F2C"
                            BorderBrush="#263545"
                            BorderThickness="0,0,0,1"
                            Padding="16,11"
                            CornerRadius="8,8,0,0">

                            <Grid ColumnDefinitions="*,Auto">

                                <StackPanel
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="9">

                                    <Border
                                        Width="8"
                                        Height="8"
                                        Background="#4BA3D3"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Text="INFORMACIÓN DEL STENCIL"
                                        Foreground="#DCE6EF"
                                        FontSize="14"
                                        FontWeight="SemiBold"/>

                                </StackPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="CONSULTA"
                                    Foreground="#60768B"
                                    FontSize="11"
                                    FontWeight="Bold"/>

                            </Grid>

                        </Border>


                        <Grid
                            Grid.Row="1"
                            Margin="18"
                            RowDefinitions="Auto,12,Auto,12,Auto,12,Auto,18,*">

                            <!-- MODELO -->

                            <Border
                                Grid.Row="0"
                                Background="#0A121B"
                                BorderBrush="#243341"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12">

                                <Grid ColumnDefinitions="115,*">

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="MODELO"
                                        Foreground="#72869A"
                                        FontSize="11"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding StencilModel}"
                                        Foreground="#F2F6FA"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"/>

                                </Grid>

                            </Border>


                            <!-- LADO -->

                            <Border
                                Grid.Row="2"
                                Background="#0A121B"
                                BorderBrush="#243341"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12">

                                <Grid ColumnDefinitions="115,*">

                                    <TextBlock
                                        Text="LADO"
                                        Foreground="#72869A"
                                        FontSize="11"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding StencilSide}"
                                        Foreground="#DDE8F0"
                                        FontSize="14"
                                        FontWeight="SemiBold"/>

                                </Grid>

                            </Border>


                            <!-- UBICACIÓN -->

                            <Border
                                Grid.Row="4"
                                Background="#0A121B"
                                BorderBrush="#243341"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12">

                                <Grid ColumnDefinitions="115,*">

                                    <TextBlock
                                        Text="UBICACIÓN"
                                        Foreground="#72869A"
                                        FontSize="11"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding CurrentLocation}"
                                        Foreground="#DDE8F0"
                                        FontSize="14"
                                        FontWeight="SemiBold"/>

                                </Grid>

                            </Border>


                            <!-- ESTADO -->

                            <Border
                                Grid.Row="6"
                                Background="#0A121B"
                                BorderBrush="#243341"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12">

                                <Grid ColumnDefinitions="115,*">

                                    <TextBlock
                                        Text="ESTADO"
                                        Foreground="#72869A"
                                        FontSize="11"
                                        FontWeight="Bold"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding StencilStatus}"
                                        Foreground="#75C69B"
                                        FontSize="14"
                                        FontWeight="Bold"/>

                                </Grid>

                            </Border>


                            <!-- MENSAJE DEL SISTEMA -->

                            <Border
                                Grid.Row="8"
                                Background="#101C28"
                                BorderBrush="#2D465A"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14"
                                VerticalAlignment="Stretch">

                                <StackPanel
                                    Spacing="9"
                                    VerticalAlignment="Top">

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8">

                                        <Border
                                            Width="7"
                                            Height="7"
                                            Background="#4BA3D3"
                                            CornerRadius="4"
                                            VerticalAlignment="Center"/>

                                        <TextBlock
                                            Text="ESTADO DEL PROCESO"
                                            Foreground="#7694AA"
                                            FontSize="10"
                                            FontWeight="Bold"/>

                                    </StackPanel>

                                    <TextBlock
                                        Text="{Binding Message}"
                                        Foreground="#DCE6EF"
                                        FontSize="13"
                                        TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </Grid>

                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- HISTORIAL -->
            <!-- ================================================= -->

            <Border
                Grid.Row="4"
                Background="#0F1824"
                BorderBrush="#263545"
                BorderThickness="1"
                CornerRadius="8">

                <Grid RowDefinitions="Auto,*">

                    <!-- CABECERA TABLA -->

                    <Border
                        Grid.Row="0"
                        Background="#131F2C"
                        BorderBrush="#263545"
                        BorderThickness="0,0,0,1"
                        Padding="16,11"
                        CornerRadius="8,8,0,0">

                        <Grid ColumnDefinitions="*,Auto">

                            <StackPanel
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="10">

                                <Border
                                    Width="8"
                                    Height="8"
                                    Background="#D2A84C"
                                    CornerRadius="4"
                                    VerticalAlignment="Center"/>

                                <StackPanel>

                                    <TextBlock
                                        Text="ÚLTIMOS REPORTES"
                                        Foreground="#DCE6EF"
                                        FontSize="14"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Text="Últimos 20 registros de daño"
                                        Foreground="#687C8F"
                                        FontSize="10"/>

                                </StackPanel>

                            </StackPanel>


                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="6">

                                <TextBlock
                                    Text="●"
                                    Foreground="#62B58A"
                                    FontSize="11"/>

                                <TextBlock
                                    Text="HISTORIAL"
                                    Foreground="#71879A"
                                    FontSize="10"
                                    FontWeight="Bold"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- TABLA -->

                    <DataGrid
                        Grid.Row="1"
                        ItemsSource="{Binding LastDamageReports}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        SelectionMode="Single"
                        Background="#0C141D"
                        Foreground="#DCE6EF"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="ID"
                                Binding="{Binding IdReport}"
                                Width="110"/>

                            <DataGridTextColumn
                                Header="FECHA / HORA"
                                Binding="{Binding DateText}"
                                Width="150"/>

                            <DataGridTextColumn
                                Header="STEEL NO."
                                Binding="{Binding SteelNo}"
                                Width="125"/>

                            <DataGridTextColumn
                                Header="MODELO"
                                Binding="{Binding Model}"
                                Width="150"/>

                            <DataGridTextColumn
                                Header="LADO"
                                Binding="{Binding Side}"
                                Width="75"/>

                            <DataGridTextColumn
                                Header="LÍNEA"
                                Binding="{Binding Line}"
                                Width="75"/>

                            <DataGridTextColumn
                                Header="REPORTA"
                                Binding="{Binding Reporter}"
                                Width="105"/>

                            <DataGridTextColumn
                                Header="TIPO DE DAÑO"
                                Binding="{Binding DamageType}"
                                Width="175"/>

                            <DataGridTextColumn
                                Header="DESCRIPCIÓN"
                                Binding="{Binding Description}"
                                Width="*"/>

                            <DataGridTextColumn
                                Header="ESTADO"
                                Binding="{Binding Status}"
                                Width="115"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>