<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Esclean.Views.Stencils.StencilInventoryView">

    <Grid>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock
                Text="INVENTARIO DE STENCILES"
                FontSize="26"
                FontWeight="Bold"/>

            <TextBlock
                Text="Consulta de herramental disponible"
                Margin="0,8,0,0"/>

        </StackPanel>

    </Grid>

</UserControl>